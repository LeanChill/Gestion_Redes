{
    "name": "sistema/gestion-redes",
    "description": "Sistema de Gestion de Redes Locales - Arquitectura MVC con Slim Framework 4",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "config/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
